{
  "name": "music-sign-adventure-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "serve": "node scripts/serve-static.js",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:full": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual --pass-with-no-tests",
    "test:update-visual": "playwright test --grep @visual --update-snapshots --pass-with-no-tests",
    "assets:export": "node scripts/export-harmonia-assets.js && node scripts/make-style-sheet.js",
    "assets:validate": "node scripts/validate-harmonia-assets.js",
    "serve:dist": "node scripts/serve-static.js --dist",
    "assets:capture": "node scripts/capture-assets.js --built"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "sharp": "0.35.5"
  }
}
